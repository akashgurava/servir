#!/usr/bin/env bash
set -e

if ! command -v cargo &> /dev/null; then
    echo "cargo not found, skipping checks"
    exit 0
fi

echo "Checking formatting..."
cargo fmt --all -- --check

echo "Running clippy..."
cargo clippy --workspace --all-targets -- -D warnings

echo "Running tests..."
cargo test --workspace --quiet

echo "All checks passed."
